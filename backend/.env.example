PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/raihan_farm_erp
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma separated list of allowed frontend origins. Leave empty to allow all (dev only).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Time zone used for dates / clock-in stamps
TIMEZONE=Asia/Colombo

# Create the admin account on first start. Set unique credentials before running.
ADMIN_USERNAME=
ADMIN_PASSWORD=
